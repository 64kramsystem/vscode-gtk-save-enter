#!/bin/sh
repo_dir=$(dirname -- "$(readlink -f -- "$0")")
module_path="$repo_dir/libgtk-save-enter.so"
if [ ! -r "$module_path" ]; then
	printf 'Run make in %s first.\n' "$repo_dir" >&2
	exit 1
fi
case ":${GTK3_MODULES:-}:" in
	*":$module_path:"*) ;;
	*) GTK3_MODULES="${GTK3_MODULES:+$GTK3_MODULES:}$module_path" ;;
esac
export GTK3_MODULES
exec /usr/bin/code "$@"
